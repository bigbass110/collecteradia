# Modèle des secrets. Sur Streamlit Community Cloud : coller ce contenu (rempli) dans
# App settings > Secrets. En local : copier en .streamlit/secrets.toml (jamais versionné).

# "google" : production, connexion Google        "mot_de_passe" : essais locaux uniquement
MODE_ACCES = "google"
# "r2" : Cloudflare R2 (production)              "local" : dossier donnees/ (essais)
STOCKAGE = "r2"

# Comptes Google autorisés à l'onglet Administration
ADMIN_EMAILS = ["coordinateur@gmail.com"]

# Voix réservées au test « voix nouvelles » : jamais en entraînement. À choisir AVANT qu'elles
# enregistrent (elles ne lisent que les phrases réservées au test). 1 ou 2 radiologues suffisent.
TEST_LOCUTEURS = ["dr09"]

# Nombre de voix distinctes visé pour chaque terme du lexique (pilote la sélection des phrases)
CIBLE_VOIX = 5
# Objectif de textes par séance affiché aux radiologues
OBJECTIF_SEANCE = 20
# true : seuls les enregistrements validés (automatiquement ou par le coordinateur) entrent dans
# les instantanés. false : tous, sauf ceux « à vérifier » ou rejetés.
EXIGER_VALIDATION = false

# Programme GPU d'étiquetage des dictées réelles (gpu/modal_etiquetage.py)
MODAL_URL = "https://<votre-espace>--radia-etiquetage-lancer.modal.run"
MODAL_JETON = "meme-chaine-que-RADIA_JETON-dans-le-secret-modal"

# Comptes Google des radiologues -> code pseudonyme
[locuteurs]
"radiologue.un@gmail.com" = "dr01"
"radiologue.deux@gmail.com" = "dr02"
"radiologue.test@gmail.com" = "dr09"

# Connexion Google (identifiants OAuth créés dans Google Cloud Console)
[auth]
redirect_uri = "https://VOTRE-APP.streamlit.app/oauth2callback"
cookie_secret = "une-longue-chaine-aleatoire-a-generer"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Cloudflare R2 (jeton en lecture ET écriture, limité au compartiment)
[r2]
account_id = "identifiant-du-compte-cloudflare"
access_key_id = "cle-d-acces-r2"
secret_access_key = "cle-secrete-r2"
bucket = "radia-collecte"

# Uniquement en MODE_ACCES = "mot_de_passe"
# APP_PASSWORD = "a-remplacer"
